# ─── Server ────────────────────────────────────────
PORT=3000

# ─── Poster OAuth App (created once at dev.joinposter.com) ─────────────────────
# Get these from: https://dev.joinposter.com → My Apps → your app → Settings
POSTER_APP_ID=your_app_id
POSTER_APP_SECRET=your_app_secret
POSTER_REDIRECT_URI=https://your-server.railway.app/oauth/callback

# ─── Quick-connect (single store, alternative to stores.json) ──────────────────
# For multi-store, use config/stores.json instead (see stores.example.json)
POSTER_TOKEN=748039:your_token_here
